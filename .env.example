# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Database
POSTGRES_USER=supmeal
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=supmeal

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=change_this_in_production_very_long_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret_key

# Application
NODE_ENV=production
CLIENT_URL=http://localhost:8080
VITE_API_URL=
OAUTH_CALLBACK_BASE=http://localhost:3000

# OAuth2 - Google (optional)
# https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - GitHub (optional)
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth2 - Microsoft (optional)
# https://portal.azure.com/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
