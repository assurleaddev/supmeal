generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Users & Authentication
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthAccounts       OAuthAccount[]
  preferences         UserPreferences?
  ownedCookbooks      Cookbook[]       @relation("CookbookOwner")
  cookbookMemberships CookbookMember[]
  cookbookInvitesSent CookbookInvite[] @relation("InvitedBy")
  recipes             Recipe[]
  favorites           Favorite[]
  mealPlans           MealPlan[]
  comments            Comment[]
  messages            Message[]

  @@index([email])
  @@index([username])
}

model OAuthAccount {
  id           String  @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  diet            String[]
  allergies       String[]
  cuisineTypes    String[]
  defaultPortions Int      @default(4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// Cookbooks
// ─────────────────────────────────────────

enum CookbookRole {
  CREATOR
  EDITOR
  COMMENTER
  READER
}

model Cookbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation("CookbookOwner", fields: [createdById], references: [id])
  members   CookbookMember[]
  recipes   Recipe[]
  messages  Message[]
  invites   CookbookInvite[]
  mealPlans MealPlan[]

  @@index([createdById])
}

model CookbookMember {
  id         String       @id @default(cuid())
  cookbookId String
  userId     String
  role       CookbookRole @default(READER)
  joinedAt   DateTime     @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, userId])
  @@index([cookbookId])
  @@index([userId])
}

model CookbookInvite {
  id          String       @id @default(cuid())
  cookbookId  String
  email       String
  token       String       @unique @default(cuid())
  role        CookbookRole @default(READER)
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime     @default(now())

  cookbook  Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([cookbookId])
  @@index([token])
}

// ─────────────────────────────────────────
// Recipes
// ─────────────────────────────────────────

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  prepTime    Int?
  cookTime    Int?
  portions    Int      @default(4)
  sourceUrl   String?
  imageUrl    String?
  isPersonal  Boolean  @default(true)
  createdById String
  cookbookId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User               @relation(fields: [createdById], references: [id])
  cookbook      Cookbook?          @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  ingredients   RecipeIngredient[]
  steps         RecipeStep[]
  tags          RecipeTag[]
  favorites     Favorite[]
  comments      Comment[]
  mealPlanItems MealPlanItem[]

  @@index([createdById])
  @@index([cookbookId])
  @@index([title])
}

model Ingredient {
  id   String @id @default(cuid())
  name String @unique

  recipeIngredients RecipeIngredient[]

  @@index([name])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         String?
  notes        String?
  orderIndex   Int     @default(0)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeStep {
  id          String @id @default(cuid())
  recipeId    String
  orderIndex  Int
  description String
  duration    Int?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// ─────────────────────────────────────────
// Tags & Categories
// ─────────────────────────────────────────

enum TagType {
  CATEGORY
  DIET
  DIFFICULTY
  CUISINE
  CUSTOM
}

model Tag {
  id   String  @id @default(cuid())
  name String  @unique
  type TagType @default(CUSTOM)

  recipes RecipeTag[]

  @@index([name])
  @@index([type])
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

// ─────────────────────────────────────────
// Favorites
// ─────────────────────────────────────────

model Favorite {
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([userId])
}

// ─────────────────────────────────────────
// Meal Planning
// ─────────────────────────────────────────

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealPlan {
  id         String   @id @default(cuid())
  userId     String
  cookbookId String?
  name       String?
  weekStart  DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookbook Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: SetNull)
  items    MealPlanItem[]

  @@index([userId])
  @@index([cookbookId])
  @@index([weekStart])
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  date       DateTime @db.Date
  mealType   MealType
  portions   Int?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id])

  @@index([mealPlanId])
  @@index([date])
}

// ─────────────────────────────────────────
// Comments & Messaging
// ─────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  cookbookId String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cookbookId])
  @@index([userId])
  @@index([createdAt])
}
